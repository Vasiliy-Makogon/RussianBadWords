{
    "name": "krugozor/russian-bad-words",
    "description": "Словари мата, грубой лексики и стоп-слов с валидатором для русскоязычного пользовательского контента на PHP",
    "type": "library",
    "homepage": "https://github.com/Vasiliy-Makogon/RussianBadWords",
    "keywords": [
        "bad words",
        "profanity filter",
        "obscenity filter",
        "russian bad words",
        "russian profanity",
        "russian obscenities",
        "ненормативная лексика",
        "фильтр мата",
        "фильтр ненормативной лексики",
        "словарь мата",
        "словарь ненормативной лексики",
        "словарь плохих русских слов",
        "словарь плохих слов",
        "фильтр ругательств",
        "цензура текста",
        "модерация контента",
        "content moderation",
        "text filtering",
        "blacklist words"
    ],
    "authors": [
        {
            "name": "Vasiliy Makogon"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6"
    },
    "suggest": {
        "ext-intl": "Композиция NFC для составных символов Unicode при нормализации слов"
    },
    "autoload": {
        "psr-4": {
            "Krugozor\\RussianBadWords\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Krugozor\\RussianBadWords\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    }
}
